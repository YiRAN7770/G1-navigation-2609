diff --git a/setup.sh b/setup.sh
index 819b055..cb34748 100755
--- a/setup.sh
+++ b/setup.sh
@@ -1,8 +1,17 @@
 #!/bin/bash
 echo "Setup unitree ros2 environment"
-source /opt/ros/foxy/setup.bash
-source $HOME/unitree_ros2/cyclonedds_ws/install/setup.bash
+# Start from a clean ROS prefix chain.  The user's interactive shell may have
+# sourced unrelated TurtleBot/OriginBot overlays before this script is called.
+unset AMENT_PREFIX_PATH CMAKE_PREFIX_PATH COLCON_PREFIX_PATH PYTHONPATH
+unset ROS_PACKAGE_PATH COLCON_CURRENT_PREFIX
+unset LD_LIBRARY_PATH
+source /opt/ros/humble/setup.bash
+_UNITREE_ROS2_DIR="$(builtin cd "$(dirname "${BASH_SOURCE[0]}")" > /dev/null && pwd)"
+source "${_UNITREE_ROS2_DIR}/cyclonedds_ws/install/local_setup.bash"
+unset _UNITREE_ROS2_DIR
 export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
+export ROS_DOMAIN_ID=0
+export ROS_LOCALHOST_ONLY=0
 export CYCLONEDDS_URI='<CycloneDDS><Domain><General><Interfaces>
-                            <NetworkInterface name="enp3s0" priority="default" multicast="default" />
+                            <NetworkInterface name="eno1" priority="default" multicast="default" />
                         </Interfaces></General></Domain></CycloneDDS>'
